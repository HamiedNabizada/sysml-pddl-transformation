#readPinArgs($sp)
#if($pinArgsResult != "")#set($spAnn = "${spAnn}/a=$pinArgsResult")#end
#end
#if($report.containsStereotype($sp.type, "PDDL_Function"))#readNumTags($sp)#set($spAnn = "${spAnn}/num")#if($fpCmp)#set($spAnn = "${spAnn}/c=$fpCmp.name")#end#if($fpHasVal)#set($spAnn = "${spAnn}/v=$fpVal")#end#if($fpOpd)#set($spAnn = "${spAnn}/o=$fpOpd.name")#end#end
#set($sig = "${sig}[in ${sp.name}:${sp.type.name}${spAnn}]")
#end
#end
#end

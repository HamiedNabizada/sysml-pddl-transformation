## -----------------------------------------------------------------------------
## Macro: derive requirements from a formula (recursive).
## $rsWo: "pre" for conditions, "eff" for effects. Sets $reqOr, $reqEx, $reqFa, $reqWhen, $reqNeg.
## $rsN is global: it is read in the if/elseif before the recursive call and not afterwards.
## -----------------------------------------------------------------------------
#macro(reqScan $rsF $rsWo)##
#if($report.containsStereotype($rsF, "PDDL_Or") || $report.containsStereotype($rsF, "PDDL_Imply"))#set($reqOr = true)#end##
#if($report.containsStereotype($rsF, "PDDL_Exists"))#set($reqEx = true)#end##
#if($report.containsStereotype($rsF, "PDDL_Forall"))#if($rsWo == "eff")#set($reqWhen = true)#else#set($reqFa = true)#end#end##
#if($report.containsStereotype($rsF, "PDDL_ConditionalEffect"))#set($reqWhen = true)#end##
#if($report.containsStereotype($rsF, "PDDL_Not") && $rsWo != "eff")##
#foreach($rsNt in $rsF.taggedValue)#if($rsNt.tagDefinition && $rsNt.tagDefinition.name == "operand" && $rsNt.value && $rsNt.value.size() > 0)#if(!$report.containsStereotype($rsNt.value.get(0), "PDDL_PredicateAtom"))#set($reqOr = true)#else#set($reqNeg = true)#end#end#end##
#end##
#foreach($rsTv in $rsF.taggedValue)#if($rsTv.tagDefinition && $rsTv.value && $rsTv.value.size() > 0)##
#set($rsN = $rsTv.tagDefinition.name)##
#if($rsN == "condition")#foreach($rsK in $rsTv.value)#reqScan($rsK "pre")#end##
#elseif($rsN == "operands" || $rsN == "operand" || $rsN == "scope" || $rsN == "consequence" || $rsN == "effect")#foreach($rsK in $rsTv.value)#reqScan($rsK $rsWo)#end##
#end##
#end#end##
#end

## -----------------------------------------------------------------------------
## Macros: check for action costs. They set $acOk = false as soon as something does not fit; $acTc is the
## function total-cost without parameters. acValue: amount of an increase (formula: literal >= 0 or function
## atom of another function; number: >= 0). acEffect: numeric effect, only increase on total-cost is allowed.
## acScan: formula tree (no comparison allowed, numeric effects checked), children as in reqScan.
## -----------------------------------------------------------------------------
#macro(acValue $acW $acIsFormula)##
#if($acIsFormula)##
#if($report.containsStereotype($acW, "PDDL_Literal"))##
#set($acLit = "")#foreach($acLv in $acW.taggedValue)#if($acLv.tagDefinition && $acLv.tagDefinition.name == "value" && $acLv.value && $acLv.value.size() > 0)#set($acLit = "$acLv.value.get(0)")#end#end##
#if($acLit.trim() == "" || $acLit.trim().startsWith("-"))#set($acOk = false)#end##
#elseif($report.containsStereotype($acW, "PDDL_FunctionAtom"))##
#set($acFn = false)#foreach($acLv in $acW.taggedValue)#if($acLv.tagDefinition && $acLv.tagDefinition.name == "function" && $acLv.value && $acLv.value.size() > 0)#set($acFn = $acLv.value.get(0))#end#end##
#if(!$acFn || $acFn == $acTc)#set($acOk = false)#end##
#else#set($acOk = false)#end##
#else##
#set($acNumber = "$acW")##
#if($acNumber.trim().startsWith("-"))#set($acOk = false)#end##
#end##
#end
#macro(acEffect $acTarget $acOp $acW $acIsFormula)##
#if($acTc && $acTarget == $acTc)#set($acHatTc = true)#end##
#if(!$acTc || $acTarget != $acTc || $acOp != "increase")#set($acOk = false)#else#acValue($acW $acIsFormula)#end##
#end
#macro(acScan $acF)##
#if($report.containsStereotype($acF, "PDDL_Comparison"))#set($acOk = false)#end##
#set($acOpN = "")##
#if($report.containsStereotype($acF, "PDDL_Increase"))#set($acOpN = "increase")#elseif($report.containsStereotype($acF, "PDDL_Decrease") || $report.containsStereotype($acF, "PDDL_Assign") || $report.containsStereotype($acF, "PDDL_ScaleUp") || $report.containsStereotype($acF, "PDDL_ScaleDown"))#set($acOpN = "other")#end##
#if($acOpN != "")##
#set($acT = false)#set($acV = false)##
#foreach($acTv in $acF.taggedValue)#if($acTv.tagDefinition && $acTv.value && $acTv.value.size() > 0)#if($acTv.tagDefinition.name == "target")#set($acT = $acTv.value.get(0))#end#if($acTv.tagDefinition.name == "value")#set($acV = $acTv.value.get(0))#end#end#end##
#if(!$acT || !$acV)#set($acOk = false)#else#acEffect($acT $acOpN $acV true)#end##
#end##
#foreach($acTv in $acF.taggedValue)#if($acTv.tagDefinition && $acTv.value && $acTv.value.size() > 0)##
#set($acN = $acTv.tagDefinition.name)##

## =============================================================================
## VTL template: PDDL domain generation
## =============================================================================
## Generates a PDDL domain from an annotated SysML model.
##
## Run it from MSoSA through Tools > Report Wizard. The report scope has to
## include the package carrying <<PDDL_Domain>>. Predicates, functions and
## annotated calls may live in other packages; they are searched model-wide.
##
## If something is missing in the model, a visible note goes into the output
## instead of a substitute value. A construct the template cannot express
## appears as an UNKNOWN-... marker.
##
## Durative actions are not generated. If an action carries
## <<PDDL_DurativeAction>>, the template says so in the output instead of
## dropping the temporal semantics.
##
## Domain constants: every <<PDDL_Constant>> becomes an entry in (:constants ...),
## named by its tag constantName (otherwise the element name) and typed by its
## tag typeRef (otherwise its first classifier). In Mode B formulas a constant is
## referenced by name in the 'arguments' tag of an atom, like any other argument.
##
## -----------------------------------------------------------------------------
## Two ways to give precondition and effect
## -----------------------------------------------------------------------------
## Mode B, through formulas: the tagged values 'precondition' and 'effect' of
##   the action point at formula stereotypes, which are rendered here.
##
## Mode A, through pins: both are derived from the pins of the action. A pin
##   whose type is a signal with <<PDDL_Predicate>> stands for an atom; incoming
##   pins form the precondition, outgoing pins the effect. Parameter pins carry
##   block types with <<PDDL_Type>>. Pins of any other type are ignored, so
##   <<PDDL_Action>> can sit on a real process action without its pins ending up
##   in :parameters. A pin typed with a <<PDDL_Function>> carries a numeric
##   condition or effect: on an input pin, 'comparison' gives (op (f args) rhs)
##   in the precondition; on an output pin, 'numericEffect' gives
##   (increase (f args) rhs) and the like in the effect. The right-hand side is
##   'numericValue' or 'numericOperand' (<<PDDL_PinAnnotation>>). The function's
##   arguments are bound like a predicate's. Function pins without these tags are
##   noted in the output and not transformed. Function pins are not parameters
##   and are not subject to the negation rule.
##
##   The marks isNegated and isPreserved reach a pin in two ways: through an
##   ObjectFlow with <<PDDL_FlowAnnotation>> connecting the producing output pin
##   to the consuming input pin, or directly on the pin via
##   <<PDDL_PinAnnotation>>. The annotation on the pin wins.
##
##   A predicate pin can name the arguments of its atom in the tag 'arguments'
##   of <<PDDL_PinAnnotation>>, as the names of parameter pins of the same
##   action. The negation rule then compares whole atoms instead of predicate
##   names, so (on ?c ?from) is deleted when an output pin sets (on ?c ?to).
##
## The choice is made per action: if 'precondition' or 'effect' is set, Mode B
## applies to the whole action, otherwise Mode A. If only one of the two is set,
## the template notes that in the output.
##
## Negation rule: what appears in the precondition, no longer in the effect and
## is not marked as preserved gets deleted. The set of preserved predicates is
## empty by default. It comes from the model alone.
##
## -----------------------------------------------------------------------------
## Reading tagged values
## -----------------------------------------------------------------------------
## $report.getStereotypePropertyFirst() returns empty values in MSoSA 2024x,
## so tags are read directly from $elem.taggedValue.
##
## Always by tagDefinition.name, never by position: MSoSA omits a tag that
## is not set instead of leaving an empty slot, the remaining entries move up,
## and the wrong value would be rendered without any sign of it.
##
## In Velocity, #set does not assign when the expression
## evaluates to null. Every branch resets its variables before reading, or an
## element would inherit the value of the previous macro call.
##
## An unknown or incomplete construct produces a visible marker
## (UNKNOWN-ATOM, UNKNOWN-OR and so on). Junctors with fewer than two operands
## are rendered as a marker as well. They are valid PDDL syntax but not what
## the modeler meant, and the rule suite reports them on the model (FML-01,
## FML-02).
## =============================================================================

## -----------------------------------------------------------------------------
## Predicate atom -> (predName ?arg1 ?arg2 ...)
## Nullary atoms have no arguments tag, hence the size() > 0 guard.
## -----------------------------------------------------------------------------
#macro(atomToPDDL $atom)##
#set($signal = false)##
#set($args = [])##
#foreach($tv in $atom.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "predicate")#set($signal = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "arguments")#set($args = $tv.value)#end##
#end##
#end##
#if(!$signal)##
(UNKNOWN-ATOM-$atom.name)##
#else##
#set($predName = $signal.predicatename)##
#if(!$predName || $predName == "")#set($predName = $signal.name)#end##
($predName#foreach($arg in $args) $arg#end)##
#end##
#end

## -----------------------------------------------------------------------------
## Function atom -> (funcName ?arg1 ?arg2 ...) or (funcName)
## -----------------------------------------------------------------------------
#macro(functionAtomToPDDL $atom)##
#set($funcRef = false)##
#set($fArgs = [])##
#foreach($tv in $atom.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "function")#set($funcRef = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "arguments")#set($fArgs = $tv.value)#end##
#end##
#end##
#if(!$funcRef)##
(UNKNOWN-FUNCTION-ATOM-$atom.name)##
#else##
#set($funcName = $funcRef.functionname)##
#if(!$funcName || $funcName == "")#set($funcName = $funcRef.name)#end##
($funcName#foreach($fArg in $fArgs) $fArg#end)##
#end##
#end

## -----------------------------------------------------------------------------
## Target of a numeric effect -> (funcName args...)
## The target references a PDDL_Function directly, not a FunctionAtom. Its
## arguments come from the tag 'targetArguments'; a nullary function such as
## total-cost renders as (total-cost). If the number of arguments differs from
## the function's arity, a note goes to $formulaWarn and the target is rendered
## as modeled.
## -----------------------------------------------------------------------------
#macro(functionRefToPDDL $funcRef $frArgs $frOwner)##
#set($frName = "")##
#set($frName = $funcRef.functionname)##
#if(!$frName || $frName == "")#set($frName = $funcRef.name)#end##
#set($frArity = 0)##
#if($funcRef.ownedAttribute)#foreach($frAttr in $funcRef.ownedAttribute)#if($frAttr.name && $frAttr.type)#set($frArity = $frArity + 1)#end#end#end##
#if($frArity != $frArgs.size())#set($dummy = $formulaWarn.add("numeric effect '$frOwner': target function '$frName' has $frArity parameter(s), targetArguments gives $frArgs.size(); rendered as modeled"))#end##
($frName#foreach($frArg in $frArgs) $frArg#end)##
#end

## -----------------------------------------------------------------------------
## Formula -> PDDL, recursive, covers every formula stereotype.
## The final else renders a marker rather than an empty string.
## -----------------------------------------------------------------------------
#macro(formulaToPDDL $formula)##
## Logical operators
#set($isAnd = $report.containsStereotype($formula, "PDDL_And"))##
#set($isOr = $report.containsStereotype($formula, "PDDL_Or"))##
#set($isNot = $report.containsStereotype($formula, "PDDL_Not"))##
#set($isImply = $report.containsStereotype($formula, "PDDL_Imply"))##
## Atomic formulas
#set($isAtom = $report.containsStereotype($formula, "PDDL_PredicateAtom"))##
#set($isFuncAtom = $report.containsStereotype($formula, "PDDL_FunctionAtom"))##
#set($isLiteral = $report.containsStereotype($formula, "PDDL_Literal"))##
## Numeric effects
#set($isIncrease = $report.containsStereotype($formula, "PDDL_Increase"))##
#set($isDecrease = $report.containsStereotype($formula, "PDDL_Decrease"))##
#set($isAssign = $report.containsStereotype($formula, "PDDL_Assign"))##
#set($isScaleUp = $report.containsStereotype($formula, "PDDL_ScaleUp"))##
#set($isScaleDown = $report.containsStereotype($formula, "PDDL_ScaleDown"))##
## Comparison and conditional formulas
#set($isComparison = $report.containsStereotype($formula, "PDDL_Comparison"))##
#set($isArith = $report.containsStereotype($formula, "PDDL_ArithmeticExpression"))##
#set($isConditional = $report.containsStereotype($formula, "PDDL_ConditionalEffect"))##
## Quantifiers
#set($isExists = $report.containsStereotype($formula, "PDDL_Exists"))##
#set($isForall = $report.containsStereotype($formula, "PDDL_Forall"))##
##
#if($isAnd && $formula.taggedValue)##
#set($subs = [])##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "operands")#set($subs = $tv.value)#end##
#end##
#end##
#if($subs.size() < 2)##
(UNKNOWN-AND-$formula.name)##
#else##
(and#foreach($sub in $subs) #formulaToPDDL($sub)#end)##
#end##
##
#elseif($isOr && $formula.taggedValue)##
#set($subs = [])##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "operands")#set($subs = $tv.value)#end##
#end##
#end##
#if($subs.size() < 2)##
(UNKNOWN-OR-$formula.name)##
#else##
(or#foreach($sub in $subs) #formulaToPDDL($sub)#end)##
#end##
##
#elseif($isNot && $formula.taggedValue)##
#set($inner = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "operand")#set($inner = $tv.value.get(0))#end##
#end##
#end##
#if(!$inner)##
(UNKNOWN-NOT-$formula.name)##
#else##
(not #formulaToPDDL($inner))##
#end##
##
#elseif($isImply && $formula.taggedValue)##
#set($implyCond = false)##
#set($implyConseq = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "condition")#set($implyCond = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "consequence")#set($implyConseq = $tv.value.get(0))#end##
#end##
#end##
#if(!$implyCond || !$implyConseq)##
(UNKNOWN-IMPLY-$formula.name)##
#else##
## Velocity variables are global: a nested imply in the condition would
## overwrite $implyConseq. The list is built before the recursive calls.
(imply#foreach($imSub in [$implyCond, $implyConseq]) #formulaToPDDL($imSub)#end)##
#end##
##
#elseif($isAtom)##
#atomToPDDL($formula)##
##
#elseif($isFuncAtom)##
#functionAtomToPDDL($formula)##
##
#elseif($isLiteral && $formula.taggedValue)##
## The value goes straight into the output here, so it is checked before it
## is written. A model element rather than a number would otherwise end up
## in the file as a Java object reference.
#set($litValue = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "value")#set($litValue = $tv.value.get(0))#end##
#end##
#end##
#if(!$litValue)##
(UNKNOWN-LITERAL-$formula.name)##
#else##
$litValue##
#end##
##
## Numeric effects, pattern: (keyword (target-func) value-formula)
## target -> reference to a PDDL_Function
## value, factor or divisor -> a numeric term (PDDL_Formula element)
## targetArguments -> arguments of the target function
##
#elseif($isIncrease && $formula.taggedValue)##
#set($neTarget = false)##
#set($neTArgs = [])##
#set($neValue = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "target")#set($neTarget = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "targetArguments")#set($neTArgs = $tv.value)#end##
#if($tv.tagDefinition.name == "value")#set($neValue = $tv.value.get(0))#end##
#end##
#end##
#if(!$neTarget || !$neValue)##
(UNKNOWN-INCREASE-$formula.name)##
#else##
(increase #functionRefToPDDL($neTarget $neTArgs $formula.name) #formulaToPDDL($neValue))##
#end##
##
#elseif($isDecrease && $formula.taggedValue)##
#set($neTarget = false)##
#set($neTArgs = [])##
#set($neValue = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "target")#set($neTarget = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "targetArguments")#set($neTArgs = $tv.value)#end##
#if($tv.tagDefinition.name == "value")#set($neValue = $tv.value.get(0))#end##
#end##
#end##
#if(!$neTarget || !$neValue)##
(UNKNOWN-DECREASE-$formula.name)##
#else##
(decrease #functionRefToPDDL($neTarget $neTArgs $formula.name) #formulaToPDDL($neValue))##
#end##
##
#elseif($isAssign && $formula.taggedValue)##
#set($neTarget = false)##
#set($neTArgs = [])##
#set($neValue = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "target")#set($neTarget = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "targetArguments")#set($neTArgs = $tv.value)#end##
#if($tv.tagDefinition.name == "value")#set($neValue = $tv.value.get(0))#end##
#end##
#end##
#if(!$neTarget || !$neValue)##
(UNKNOWN-ASSIGN-$formula.name)##
#else##
(assign #functionRefToPDDL($neTarget $neTArgs $formula.name) #formulaToPDDL($neValue))##
#end##
##
#elseif($isScaleUp && $formula.taggedValue)##
#set($neTarget = false)##
#set($neTArgs = [])##
#set($neFactor = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "target")#set($neTarget = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "targetArguments")#set($neTArgs = $tv.value)#end##
#if($tv.tagDefinition.name == "factor")#set($neFactor = $tv.value.get(0))#end##
#end##
#end##
#if(!$neTarget || !$neFactor)##
(UNKNOWN-SCALE-UP-$formula.name)##
#else##
(scale-up #functionRefToPDDL($neTarget $neTArgs $formula.name) #formulaToPDDL($neFactor))##
#end##
##
#elseif($isScaleDown && $formula.taggedValue)##
#set($neTarget = false)##
#set($neTArgs = [])##
#set($neDivisor = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "target")#set($neTarget = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "targetArguments")#set($neTArgs = $tv.value)#end##
#if($tv.tagDefinition.name == "divisor")#set($neDivisor = $tv.value.get(0))#end##
#end##
#end##
#if(!$neTarget || !$neDivisor)##
(UNKNOWN-SCALE-DOWN-$formula.name)##
#else##
(scale-down #functionRefToPDDL($neTarget $neTArgs $formula.name) #formulaToPDDL($neDivisor))##
#end##
##
## Comparison, pattern: (operator left right)
## operator -> a ComparisonOperator literal
## left -> a PDDL_Formula element
## right -> a PDDL_Formula element
##
#elseif($isComparison && $formula.taggedValue)##
#set($cmpOp = false)##
#set($cmpLeft = false)##
#set($cmpRight = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "operator")#set($cmpOp = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "left")#set($cmpLeft = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "right")#set($cmpRight = $tv.value.get(0))#end##
#end##
#end##
#if(!$cmpOp || !$cmpLeft || !$cmpRight)##
(UNKNOWN-COMPARISON-$formula.name)##
#else##
#set($cmpOpName = $cmpOp.name)##
#if($cmpOpName == "equal")#set($cmpSymbol = "=")##
#elseif($cmpOpName == "lessThan")#set($cmpSymbol = "<")##
#elseif($cmpOpName == "greaterThan")#set($cmpSymbol = ">")##
#elseif($cmpOpName == "lessOrEqual")#set($cmpSymbol = "<=")##
#elseif($cmpOpName == "greaterOrEqual")#set($cmpSymbol = ">=")##
#else#set($cmpSymbol = $cmpOpName)##
#end##
($cmpSymbol #formulaToPDDL($cmpLeft) #formulaToPDDL($cmpRight))##
#end##
##
## Arithmetic expression, pattern: (op left right), op from ArithmeticOperator
## (plus, minus, times, divide). Operands are built into a list before the
## recursive calls, as for imply.
##
#elseif($isArith && $formula.taggedValue)##
#set($arOp = false)##
#set($arLeft = false)##
#set($arRight = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "operator")#set($arOp = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "left")#set($arLeft = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "right")#set($arRight = $tv.value.get(0))#end##
#end##
#end##
#if(!$arOp || !$arLeft || !$arRight)##
(UNKNOWN-ARITHMETIC-$formula.name)##
#else##
#set($arOpName = $arOp.name)##
#if($arOpName == "plus")#set($arSymbol = "+")##
#elseif($arOpName == "minus")#set($arSymbol = "-")##
#elseif($arOpName == "times")#set($arSymbol = "*")##
#elseif($arOpName == "divide")#set($arSymbol = "/")##
#else#set($arSymbol = "UNKNOWN-OPERATOR-$arOpName")##
#end##
($arSymbol#foreach($arSub in [$arLeft, $arRight]) #formulaToPDDL($arSub)#end)##
#end##
##
## Conditional effect
## Pattern: (when condition effect)
##
#elseif($isConditional && $formula.taggedValue)##
#set($whenCond = false)##
#set($whenEffect = false)##
#foreach($tv in $formula.taggedValue)##
#if($tv.tagDefinition && $tv.value && $tv.value.size() > 0)##
#if($tv.tagDefinition.name == "condition")#set($whenCond = $tv.value.get(0))#end##
#if($tv.tagDefinition.name == "effect")#set($whenEffect = $tv.value.get(0))#end##
#end##
#end##
#if(!$whenCond || !$whenEffect)##
(UNKNOWN-CONDITIONAL-$formula.name)##
#else##
## A single numeric effect gets the (and ...) wrapper, as the top-level effect does.##
#set($numWhen = ($report.containsStereotype($whenEffect, "PDDL_Increase") || $report.containsStereotype($whenEffect, "PDDL_Decrease") || $report.containsStereotype($whenEffect, "PDDL_Assign") || $report.containsStereotype($whenEffect, "PDDL_ScaleUp") || $report.containsStereotype($whenEffect, "PDDL_ScaleDown")))##
#if($numWhen)(when #formulaToPDDL($whenCond) (and #formulaToPDDL($whenEffect)))#{else}(when #formulaToPDDL($whenCond) #formulaToPDDL($whenEffect))#{end}##
#end##
##
## Pattern: (exists/forall (?var1 - type1 ...) scope)
## scope -> a PDDL_Formula element
## variables -> a string list, inherited from the parent stereotype
## variableTypes -> a list of PDDL_Type, inherited from the parent stereotype
##
#elseif($isExists && $formula.taggedValue)##
## Read by name: if one of the three is missing, the indices shift and a
## model element gets rendered where a variable name belongs.
#set($qScope = false)##
#set($qVars = [])##
#set($qTypes = [])##
#foreach($qtv in $formula.taggedValue)##
#if($qtv.tagDefinition && $qtv.value && $qtv.value.size() > 0)##
#if($qtv.tagDefinition.name == "scope")#set($qScope = $qtv.value.get(0))#end##
#if($qtv.tagDefinition.name == "variables")#set($qVars = $qtv.value)#end##
#if($qtv.tagDefinition.name == "variableTypes")#set($qTypes = $qtv.value)#end##
#end##
#end##
## Without variables or a body this renders a marker, not PDDL.
#if($qVars.size() == 0 || !$qScope)##
(UNKNOWN-QUANTIFIER-$formula.name)##
#else##
(exists (#foreach($qv in $qVars)#set($qi = $foreach.index)$qv#if($qTypes.size() > $qi)#set($qtE = $qTypes.get($qi))#set($qtN = $qtE.typename)#if(!$qtN || $qtN == "")#set($qtN = $qtE.name)#end - $qtN.toLowerCase()#end#if($foreach.hasNext) #end#end) #formulaToPDDL($qScope))##
#end##
##
#elseif($isForall && $formula.taggedValue)##
## Read by name: if one of the three is missing, the indices shift and a
## model element gets rendered where a variable name belongs.
#set($qScope = false)##
#set($qVars = [])##
#set($qTypes = [])##
#foreach($qtv in $formula.taggedValue)##
#if($qtv.tagDefinition && $qtv.value && $qtv.value.size() > 0)##
#if($qtv.tagDefinition.name == "scope")#set($qScope = $qtv.value.get(0))#end##
#if($qtv.tagDefinition.name == "variables")#set($qVars = $qtv.value)#end##
#if($qtv.tagDefinition.name == "variableTypes")#set($qTypes = $qtv.value)#end##
#end##
#end##
## Without variables or a body this renders a marker, not PDDL.
#if($qVars.size() == 0 || !$qScope)##
(UNKNOWN-QUANTIFIER-$formula.name)##
#else##
## A single numeric effect as the body gets the (and ...) wrapper, as the top-level effect does.##
#set($numScope = ($report.containsStereotype($qScope, "PDDL_Increase") || $report.containsStereotype($qScope, "PDDL_Decrease") || $report.containsStereotype($qScope, "PDDL_Assign") || $report.containsStereotype($qScope, "PDDL_ScaleUp") || $report.containsStereotype($qScope, "PDDL_ScaleDown")))##
(forall (#foreach($qv in $qVars)#set($qi = $foreach.index)$qv#if($qTypes.size() > $qi)#set($qtE = $qTypes.get($qi))#set($qtN = $qtE.typename)#if(!$qtN || $qtN == "")#set($qtN = $qtE.name)#end - $qtN.toLowerCase()#end#if($foreach.hasNext) #end#end) #if($numScope)(and #formulaToPDDL($qScope))#{else}#formulaToPDDL($qScope)#{end})##
#end##
##
## Unknown or incomplete formula stereotype: a visible marker instead of
## empty output. VAL then reports an unknown predicate, so the mistake
## surfaces.
#else##
(UNKNOWN-FORMULA-$formula.name)##
#end##
#end

## -----------------------------------------------------------------------------
## Mode A: read a boolean tag of a flow by name, result in $flowTagResult.
## -----------------------------------------------------------------------------
#macro(readFlowTag $edge $tagName)##
#set($flowTagResult = false)##
#if($edge.taggedValue)##
#foreach($ftv in $edge.taggedValue)##
#if($ftv.tagDefinition && $ftv.tagDefinition.name == $tagName && $ftv.value && $ftv.value.size() > 0)##
#set($ftvRaw = $ftv.value.get(0))##
#if($ftvRaw == true || $ftvRaw.toString() == "true")#set($flowTagResult = true)#end##
#end##
#end##
#end##
#end

## -----------------------------------------------------------------------------
## Mode A: read the tag 'arguments' of a predicate pin. Writes " ?a ?b"
## (lower case, '?' added) to $pinArgsResult, "" without the tag.
## -----------------------------------------------------------------------------
#macro(readPinArgs $paPin)##
#set($pinArgsResult = "")##
#if($paPin.taggedValue)##
#foreach($pav in $paPin.taggedValue)##
#if($pav.tagDefinition && $pav.tagDefinition.name == "arguments" && $pav.value && $pav.value.size() > 0)##
#foreach($pa1 in $pav.value)##
#set($pa1s = $pa1.toString().trim().toLowerCase())##
#if($pa1s.startsWith("?"))#set($pa1s = $pa1s.substring(1))#end##
#set($pinArgsResult = "$pinArgsResult ?$pa1s")##
#end##
#end##
#end##
#end##
#end
##
## -----------------------------------------------------------------------------
## Mode A: build an atom from a predicate signal and bind its parameters.
## Per predicate attribute, in this order: match by name against the action
## parameters; match by type including the generalization chain up to the
## root (first generalization, stops at a cycle); on ambiguity take the first
## hit and warn; fall back to the attribute name and warn.
## $maPTypeElems runs parallel to the parameter list and holds the pin type
## elements, needed to walk up the generalization chain.
## -----------------------------------------------------------------------------
#macro(modusAAtom $maSig $maPNames $maPTypes $maPTypeElems $maBindWarn)##
#set($maPredName = $maSig.predicatename)##
#if(!$maPredName || $maPredName == "")#set($maPredName = $maSig.name)#end##
($maPredName#modusABind($maSig $maPNames $maPTypes $maPTypeElems $maBindWarn "predicate '$maPredName'"))##
#end
##
## -----------------------------------------------------------------------------
## Mode A: build a function term from a function signal, same binding.
## -----------------------------------------------------------------------------
#macro(modusAFunc $maSig $maPNames $maPTypes $maPTypeElems $maBindWarn)##
#set($maFuncName = "")##
#set($maFuncName = $maSig.functionname)##
#if(!$maFuncName || $maFuncName == "")#set($maFuncName = $maSig.name)#end##
($maFuncName#modusABind($maSig $maPNames $maPTypes $maPTypeElems $maBindWarn "function '$maFuncName'"))##
#end
##
## -----------------------------------------------------------------------------
## Mode A: bind the attributes of a predicate or function signal to the action
## parameters. $maLabel names the predicate or function in the warnings.
## -----------------------------------------------------------------------------
#macro(modusABind $maSig $maPNames $maPTypes $maPTypeElems $maBindWarn $maLabel)##
#if($maSig.ownedAttribute)#foreach($maAttr in $maSig.ownedAttribute)#if($maAttr.name && $maAttr.type)#set($mbName = $maAttr.name.toLowerCase())#if($maPNames.contains($mbName)) ?$mbName#else#set($mbTypeName = $maAttr.type.typename)#if(!$mbTypeName || $mbTypeName == "")#set($mbTypeName = $maAttr.type.name)#end#set($mbTypeName = $mbTypeName.toLowerCase())#set($mbFound = "")#set($mbCount = 0)#if($maPNames.size() > 0)#foreach($mbCand in $maPNames)#set($mbIdx = $foreach.index)#set($mbMatch = false)#if($maPTypes.get($mbIdx) == $mbTypeName)#set($mbMatch = true)#else#set($mbTypeElem = $maPTypeElems.get($mbIdx))#if($mbTypeElem)#set($mbWalk = $mbTypeElem)#set($mbSeen = [])#foreach($mbStep in $elements)#if(!$mbWalk || $mbMatch || $mbSeen.contains($mbWalk))#break#end#set($dummy = $mbSeen.add($mbWalk))#if($mbWalk.general && $mbWalk.general.size() > 0)#set($mbWalk = $mbWalk.general.get(0))#set($mbGName = "")#set($mbGName = $mbWalk.typename)#if(!$mbGName || $mbGName == "")#set($mbGName = $mbWalk.name)#end#if($mbGName.toLowerCase() == $mbTypeName)#set($mbMatch = true)#end#else#set($mbWalk = false)#end#end#end#end#if($mbMatch)#if($mbCount == 0)#set($mbFound = $mbCand)#end#set($mbCount = $mbCount + 1)#end#end#end#if($mbFound != "")#if($mbCount > 1)#set($dummy = $maBindWarn.add("ambiguous binding: $maLabel attribute '$mbName' (type $mbTypeName) matches $mbCount parameters, using ?$mbFound"))#end ?$mbFound#else#set($dummy = $maBindWarn.add("no parameter match for $maLabel attribute '$mbName' (type $mbTypeName), using attribute name"))#end#if($mbFound == "") ?$mbName#end#end#end#end#end##
#end
